{
  "name": "country-search",
  "version": "1.0.0",
  "description": "Country Search app for Rolling Scopes School",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "tsc",
    "dev": "vitest"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
